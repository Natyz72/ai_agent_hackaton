# AI Suspicious Message Investigation Agent - Environment Variables
# Copy this file to .env and fill in values. Never commit real secrets.

# App
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# Gemini API (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (server-side only - use service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Limits
MAX_MESSAGE_LENGTH=10000
MAX_TOOL_CALLS=6
MAX_TOOL_RESULT_BYTES=100000
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
PROPOSAL_EXPIRY_MINUTES=60
